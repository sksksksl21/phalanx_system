# =========================================================
# Step 02 - Build Symbol×Window Metrics & UF Dataset (Chart+Strategy Features)
# ---------------------------------------------------------
# Purpose:
#   - Keep existing trade-log window metrics (for labels/outcomes/downstream compatibility)
#   - Add TitanStrategy + SuperTrend(SL) aligned chart/regime features (UF 2.0 spec)
#   - Output:
#       (1) symbol_window_metrics.parquet  (panel)
#       (2) uf_dataset.parquet            (features + outcomes, per asof)
#
# Notes:
#   - This step downloads/loads OHLCV (15m) for symbols appearing in trades (or per panel)
#   - Uses caching to avoid repeated downloads
#   - Works even if TitanStrategy code is unavailable: falls back to internal indicator calc
# =========================================================
from __future__ import annotations

import argparse
import os
import math
from dataclasses import dataclass
from typing import Dict, List, Optional, Tuple

import pandas as pd
import numpy as np

from universe_filter.lib.io import read_json, read_parquet, write_parquet
from universe_filter.lib.metrics import compute_symbol_window_metrics
from universe_filter.lib.features import build_feature_frame, add_derived_features, enforce_feature_policy
from universe_filter.lib.reporting import update_run_report


